# Maintainer: Dav (d4ruerk1) <d4ruerk1@users.noreply.github.com>          (Linux port / packaging)
# Upstream author: Mark Terence Tiglao      https://github.com/markterence/discord-quest-completer
#
# Arch Linux / CachyOS package for DQC Linux (Linux port of Discord Quest Completer).
# Build:   makepkg -si
# Local checkout build (no release tag needed):  ./build-local.sh

_ghuser=d4ruerk1
_repo=DQC-Linux
pkgname=dqc-linux
pkgver=1.0.1
pkgrel=1
pkgdesc="Unofficial tool that simulates games for Discord Quests (Linux port, not affiliated with Discord)"
arch=('x86_64' 'aarch64')
url="https://github.com/${_ghuser}/${_repo}"
provides=('discord-quest-completer')
conflicts=('discord-quest-completer')
replaces=('discord-quest-completer')
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'glib2'
  'cairo'
  'pango'
  'gdk-pixbuf2'
  'openssl'
  'hicolor-icon-theme'
  'gcc-libs'
  'glibc'
)
makedepends=('rust' 'nodejs' 'npm' 'git')
optdepends=(
  'discord: native Discord client (game detection needs the native, non-Flatpak client)'
  'xdg-utils: open links from the app'
)
# LTO from makepkg.conf (enabled by default on CachyOS) breaks some Rust/C
# mixed crates; Rust already uses its own LTO in the release profile.
options=('!lto' '!debug')
# GitHub strips the leading "v" from the tag: archive v1.0.1 -> DQC-Linux-1.0.1/
# build-local.sh creates this same file/dir layout from the local checkout.
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
_srcname="${_repo}-${pkgver}"
sha256sums=('SKIP')   # replace with the real checksum: updpkgsums

_pnpm() { npx --yes pnpm@8.15.3 "$@"; }   # pinned to upstream's packageManager

prepare() {
  cd "${_srcname}"
  export CARGO_HOME="${srcdir}/cargo-home"
  _pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
  cargo fetch --locked --manifest-path src-linux/Cargo.toml
}

build() {
  cd "${_srcname}"
  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_TARGET_DIR="${PWD}/target"

  # 1) tiny dummy game runner (freestanding static ELF, ~1-2 KB)
  cargo build --frozen --release --manifest-path src-linux/Cargo.toml
  install -Dm755 target/release/src-linux src-tauri/resources/src-linux

  # 2) Tauri app (frontend is built by beforeBuildCommand)
  _pnpm tauri build --no-bundle -- --frozen
}

package() {
  cd "${_srcname}"

  install -Dm755 target/release/dqc-linux \
    "${pkgdir}/usr/bin/dqc-linux"
  install -Dm755 target/release/src-linux \
    "${pkgdir}/usr/lib/dqc-linux/src-linux"

  install -Dm644 packaging/linux/dqc-linux.desktop \
    "${pkgdir}/usr/share/applications/dqc-linux.desktop"
  install -Dm644 src-tauri/icons/32x32.png \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/dqc-linux.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/dqc-linux.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/dqc-linux.png"
  install -Dm644 src-tauri/icons/icon.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/dqc-linux.png"

  # MIT: the copyright + permission notice must ship with every copy
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 NOTICE.md "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE.md"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 CREDITS.md "${pkgdir}/usr/share/doc/${pkgname}/CREDITS.md"
}
